# Workplace Booking Platform - Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env with real secrets!

# ==========================================
# DATABASE
# ==========================================
POSTGRES_DB=booking
POSTGRES_USER=booking_user
POSTGRES_PASSWORD=your_secure_password_here

# ==========================================
# MICROSOFT ENTRA ID (Azure AD)
# Solo necesario si ASPNETCORE_ENVIRONMENT=Production (auth JWT real).
# Para pruebas locales/desarrollo se usa el handler "Development" y no se requieren.
# ==========================================
AZURE_AD_DOMAIN=yourtenant.onmicrosoft.com
AZURE_AD_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_AD_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_AD_CLIENT_SECRET=your_client_secret_here

# ==========================================
# EMAIL (SMTP)
# ==========================================
EMAIL_SMTP_HOST=smtp.office365.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=noreply@yourcompany.com
EMAIL_SMTP_PASSWORD=your_smtp_password
EMAIL_FROM_ADDRESS=noreply@yourcompany.com
EMAIL_FROM_NAME=Workplace Booking Platform
EMAIL_USE_SSL=true

# ==========================================
# FRONTEND
# ==========================================
FRONTEND_BASE_URL=https://booking.yourcompany.com
VITE_API_BASE_URL=/api/v1
VITE_APP_TITLE=Workplace Booking Platform

# ==========================================
# CORS (orígenes permitidos para la API)
# ==========================================
ALLOWED_ORIGINS_0=http://localhost
ALLOWED_ORIGINS_1=http://localhost:3000

# ==========================================
# ASP.NET CORE
# ==========================================
# Development usa el handler de auth local (sin Entra ID)
ASPNETCORE_ENVIRONMENT=Development
